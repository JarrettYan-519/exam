# ================================================================
# Resume Optimization Agent · 环境变量模板
# ----------------------------------------------------------------
# 用法：cp .env.example .env 然后填入真实的 API Key
# ================================================================

# DeepSeek API Key（必填）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ---- 以下为可选配置，留空则使用默认值 ----

# DeepSeek API 基础地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型（deepseek-chat / deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 上传文件大小上限（MB）
# MAX_UPLOAD_MB=5

# 单次 LLM 调用超时时间（秒）
# REQUEST_TIMEOUT_SECONDS=120
